{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "outDir": "./node_modules/.tmp/tsconfig.node.out",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "vite.config.ts",
    "scripts/**/*.mjs",
    "scripts/**/*.d.mts",
    "src/content/news-types.ts",
    "src/shared/**/*.mjs",
    "src/shared/**/*.d.mts"
  ],
  "exclude": ["scripts/**/*.test.mjs"]
}
