{
  "name": "bluearchive-cafe-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "npm run optimize:hero && npm run generate:news:dev && vite --host 127.0.0.1",
    "generate:news:dev": "node scripts/generate-news-content.mjs --include-drafts",
    "generate:news:prod": "node scripts/generate-news-content.mjs",
    "optimize:hero": "node scripts/optimize-hero-images.mjs",
    "prune:hero": "node scripts/prune-dist-hero-originals.mjs",
    "typecheck": "npm run generate:news:dev && npm run typecheck:raw",
    "typecheck:raw": "vue-tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run generate:news:dev && vitest run",
    "audit": "npm audit --audit-level=moderate",
    "build": "npm run optimize:hero && npm run generate:news:prod && npm run typecheck:raw && vite build && npm run prune:hero && node scripts/create-pages-fallback.mjs && node scripts/generate-sitemap.mjs",
    "build:pages": "npm run build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource-utils/scss": "^0.2.4",
    "@fontsource/noto-sans": "^5.3.0",
    "@mdi/js": "^7.4.47",
    "medium-zoom": "^1.1.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "vuetify": "^4.1.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.2",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.8.0",
    "eslint-plugin-html": "^8.1.4",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "markdown-it": "^14.3.0",
    "sanitize-html": "^2.17.6",
    "sass-embedded": "^1.100.0",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8"
  }
}
